{
	"name": "bip-bop-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run generate-pico-theme-colors && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"download-font": "node --experimental-strip-types scripts/download-jetbrains-mono.mjs",
		"generate-resolution-catalog": "node scripts/generate-resolution-catalog.mjs",
		"generate-pico-theme-colors": "node --experimental-strip-types scripts/generate-pico-theme-colors.mjs",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-m-function-matcher": "^2.2.16",
		"@inlang/plugin-message-format": "^4.4.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^5.0.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lightningcss": "^1.33.0",
		"playwright": "^1.60.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.0",
		"sass-embedded": "^1.105.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@picocss/pico": "^2.1.1",
		"kiso.css": "^1.2.4",
		"mediabunny": "^1.60.0"
	}
}
